# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# ========================
# Flask sessions (legacy locations)
# ========================
.flask_session/
flask_session/
instance/

# ========================
# Node / React
# ========================
node_modules/
app/frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================
# IDE / Editor
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ========================
# Output directory (ALL runtime artifacts)
# ========================
# Everything inside output/ is generated at runtime.
# Only the directory structure itself is kept via .gitkeep files.
output/datasets/*
output/scripts/*
output/logs/*
output/plans/*
output/visualizations/*
output/sessions/*

# Keep the directory structure in git
!output/datasets/.gitkeep
!output/scripts/.gitkeep
!output/logs/.gitkeep
!output/plans/.gitkeep
!output/visualizations/.gitkeep
!output/sessions/.gitkeep

# Test datasets — keep the sample CSVs but ignore runtime copies
TestDatasets/Input.csv
TestDatasets/Input_processed.csv
TestDatasets/*.png

# Trained models (wherever they land)
*.joblib
*.pkl
*.h5
trained_model.*

# ========================
# OS files
# ========================
Thumbs.db
.DS_Store
desktop.ini